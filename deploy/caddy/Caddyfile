# Caddy in front of nginx — docs/saas-launch-plan.md §8.8.
#
# Customers point hr.theirs.pk at the platform host with a CNAME. Caddy answers
# every host on 443, asks the application whether a company owns the host, and
# issues a Let's Encrypt certificate on the first request — then renews it
# forever. Nothing per customer to run. The `ask` is what stops it issuing for
# any host that merely happens to point here.
#
# nginx keeps terminating nothing: move its listener to 127.0.0.1:8080 (plain
# HTTP) and leave `trustProxies(at: ['127.0.0.1', '::1'])` in bootstrap/app.php
# as it is — Caddy sets X-Forwarded-Proto and the application sees https.

{
	email ops@example.pk
	on_demand_tls {
		ask http://127.0.0.1:8080/domains/check
		interval 2m
		burst 5
	}
}

# The platform host itself: a normal certificate, obtained up front.
app.example.pk {
	reverse_proxy 127.0.0.1:8080
	encode zstd gzip
}

# Every other host: on-demand, gated by the ask endpoint.
https:// {
	tls {
		on_demand
	}
	reverse_proxy 127.0.0.1:8080
	encode zstd gzip
}

http:// {
	redir https://{host}{uri} permanent
}
